// ============================================================================
// IVOIREAPPRO ERP — PRISMA SCHEMA (POSTGRESQL / NEON)
// Architecture : Domain-Driven Modular Monolith Multi-Tenant (organizationId)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS MÉTIER
// ----------------------------------------------------------------------------

enum RoleName {
  OWNER
  ADMIN
  MANAGER
  LOGISTICS
  WAREHOUSE
  ACCOUNTING
  VIEWER
}

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum UnitCode {
  KG
  TON
  LITER
  UNIT
  SACK
  CARTON
  BAG
  BOX
}

enum StockMovementType {
  PURCHASE
  RECEIPT
  DELIVERY
  RETURN
  ADJUSTMENT
  LOSS
  DAMAGE
  TRANSFER
}

enum DeliveryStatus {
  DRAFT
  PLANNED
  PREPARING
  READY
  DISPATCHED
  PARTIALLY_RECEIVED
  RECEIVED
  REJECTED
  CANCELLED
  CLOSED
}

enum DocumentType {
  CONTRACT
  PURCHASE_ORDER
  DELIVERY_NOTE
  RECEIPT
  INVOICE
  PAYMENT_PROOF
  SUPPLIER_DOCUMENT
  QUALITY_DOCUMENT
  REPORT
  OTHER
}

enum DocumentStatus {
  DRAFT
  PREVIEW
  FINAL
  ARCHIVED
  SUPERSEDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  DISPUTED
}

enum TaxCertificationStatus {
  NOT_SUBMITTED
  SUBMITTED
  CERTIFIED
  REJECTED
}

enum ExpenseCategoryType {
  TRANSPORT
  FUEL
  HANDLING
  STORAGE
  PURCHASE
  MAINTENANCE
  ADMIN
  BANK_FEES
  OTHER
}

enum AuditActionType {
  CREATE
  UPDATE
  DELETE
  VALIDATE
  CANCEL
  EXPORT
  LOGIN
  DOCUMENT_GENERATED
  DOCUMENT_FINALIZED
  PAYMENT_RECORDED
}

// ----------------------------------------------------------------------------
// 6. ORGANIZATION, USERS & RBAC
// ----------------------------------------------------------------------------

model Organization {
  id                 String   @id @default(cuid())
  legalName          String
  tradeName          String
  taxId              String?  // Identifiant fiscal configurable par l'entreprise
  registrationNumber String?  // Numéro d'immatriculation commerciale configurable
  address            String
  phone              String
  email              String
  logo               String?
  currency           String   @default("XOF")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users              User[]
  roles              Role[]
  customers          Customer[]
  contracts          Contract[]
  products           Product[]
  suppliers          Supplier[]
  warehouses         Warehouse[]
  deliveries         Delivery[]
  invoices           Invoice[]
  payments           Payment[]
  expenses           Expense[]
  documents          Document[]
  documentTemplates  DocumentTemplate[]
  sequences          NumberSequence[]
  auditLogs          AuditLog[]
}

model Role {
  id             String       @id @default(cuid())
  organizationId String
  name           RoleName
  label          String
  permissions    String[]     // Granular permissions e.g. ["contracts:write", "deliveries:validate", "deliveries:override_quota"]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String       @unique
  phone          String?
  passwordHash   String
  roleId         String
  isActive       Boolean      @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [organizationId], references: [id])
  auditLogs      AuditLog[]

  @@index([organizationId])
}

// ----------------------------------------------------------------------------
// 7. CLIENTS / ORGANISMES INSTITUTIONNELS
// ----------------------------------------------------------------------------

model Customer {
  id             String            @id @default(cuid())
  organizationId String
  code           String
  name           String
  category       String            // Ex: Santé, Éducation, Administration, Collectivité
  taxIdentifier  String?
  paymentTermsDays Int             @default(45)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       CustomerContact[]
  addresses      CustomerAddress[]
  contracts      Contract[]
  invoices       Invoice[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  name       String
  roleTitle  String
  phone      String
  email      String?
  isPrimary  Boolean  @default(false)

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerAddress {
  id                  String   @id @default(cuid())
  customerId          String
  siteName            String
  city                String
  addressLine         String
  receivingHours      String?  // Règle d'accès configurable par site
  requiredDocTypes    String[] // Règles documentaires configurables par site
  contactPerson       String?
  contactPhone        String?

  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deliveries          Delivery[]
}

// ----------------------------------------------------------------------------
// 8. CONTRATS / MARCHÉS & COMMANDES
// ----------------------------------------------------------------------------

model Contract {
  id             String              @id @default(cuid())
  organizationId String
  reference      String
  title          String
  customerId     String
  startDate      DateTime
  endDate        DateTime
  status         ContractStatus      @default(DRAFT)
  currency       String              @default("XOF")
  totalAmount    Decimal             @db.Decimal(18, 2)
  notes          String?
  ruleType       String              @default("CONTRACTUAL") // Distinction règle contractuelle vs interne
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer            @relation(fields: [customerId], references: [id])
  lines          ContractLine[]
  amendments     ContractAmendment[]
  milestones     ContractMilestone[]
  orders         CustomerOrder[]
  deliveries     Delivery[]
  invoices       Invoice[]
  expenses       Expense[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
}

model ContractLine {
  id          String   @id @default(cuid())
  contractId  String
  productId   String
  unit        UnitCode
  quantity    Decimal  @db.Decimal(18, 3) // Quantité contractuelle initiale + avenants
  unitPrice   Decimal  @db.Decimal(18, 2)
  taxRate     Decimal  @db.Decimal(5, 2)  @default(0) // Configurable selon régime fiscal applicable
  totalAmount Decimal  @db.Decimal(18, 2)

  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  deliveryLines DeliveryLine[]

  @@index([contractId])
}

model ContractAmendment {
  id            String   @id @default(cuid())
  contractId    String
  reference     String
  description   String
  effectiveDate DateTime
  deltaAmount   Decimal  @db.Decimal(18, 2)
  approvedBy    String
  createdAt     DateTime @default(now())

  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model ContractMilestone {
  id          String   @id @default(cuid())
  contractId  String
  title       String
  dueDate     DateTime
  isCompleted Boolean  @default(false)

  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model CustomerOrder {
  id             String   @id @default(cuid())
  organizationId String
  reference      String
  contractId     String
  destinationId  String
  orderDate      DateTime
  requestedDate  DateTime
  status         String   @default("CONFIRMED")
  totalAmount    Decimal  @db.Decimal(18, 2)
  notes          String?

  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  deliveries     Delivery[]

  @@index([contractId])
}

// ----------------------------------------------------------------------------
// 9. PRODUITS / DENRÉES & UNITÉS DE MESURE
// ----------------------------------------------------------------------------

model Product {
  id                String                @id @default(cuid())
  organizationId    String
  reference         String
  internalCode      String
  name              String
  categoryName      String
  unit              UnitCode
  weightKg          Decimal               @db.Decimal(10, 3)
  packaging         String                // Ex: Sac polypropylène 50 kg
  conversionToKg    Decimal               @db.Decimal(10, 3) // Règle explicite ex: 1 SAC = 50 KG
  standardCost      Decimal               @db.Decimal(18, 2)
  minStockThreshold Decimal               @db.Decimal(18, 3)
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractLines     ContractLine[]
  lots              StockLot[]
  stockMovements    StockMovement[]
  deliveryLines     DeliveryLine[]
  priceHistory      ProductPriceHistory[]

  @@unique([organizationId, reference])
  @@index([organizationId])
}

model ProductPriceHistory {
  id          String   @id @default(cuid())
  productId   String
  supplierId  String?
  unitCost    Decimal  @db.Decimal(18, 2)
  recordedAt  DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// 10 & 11. FOURNISSEURS, ACHATS & STOCKS IMMUABLES
// ----------------------------------------------------------------------------

model Supplier {
  id             String          @id @default(cuid())
  organizationId String
  code           String
  name           String
  specialty      String
  phone          String
  email          String?
  city           String
  rating         Int             @default(5)
  isActive       Boolean         @default(true)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]

  @@index([organizationId])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  organizationId String
  reference      String
  supplierId     String
  orderDate      DateTime
  expectedDate   DateTime
  status         String              // DRAFT, ORDERED, RECEIVED, INVOICED, PAID
  totalAmount    Decimal             @db.Decimal(18, 2)

  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  lines          PurchaseOrderLine[]

  @@index([organizationId])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Decimal       @db.Decimal(18, 3)
  unitCost        Decimal       @db.Decimal(18, 2)
  totalAmount     Decimal       @db.Decimal(18, 2)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model Warehouse {
  id             String          @id @default(cuid())
  organizationId String
  code           String
  name           String
  location       String
  managerName    String

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lots           StockLot[]
  movements      StockMovement[]

  @@index([organizationId])
}

model StockLot {
  id               String          @id @default(cuid())
  warehouseId      String
  productId        String
  lotNumber        String
  receivedDate     DateTime
  expiryDate       DateTime
  unitCost         Decimal         @db.Decimal(18, 2)
  initialQuantity  Decimal         @db.Decimal(18, 3)
  reservedQuantity Decimal         @db.Decimal(18, 3) @default(0)

  warehouse        Warehouse       @relation(fields: [warehouseId], references: [id])
  product          Product         @relation(fields: [productId], references: [id])
  movements        StockMovement[]

  @@index([productId, expiryDate])
}

model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  warehouseId    String
  productId      String
  lotId          String?
  type           StockMovementType
  quantityDelta  Decimal           @db.Decimal(18, 3) // Positif en entrée, négatif en sortie
  referenceDoc   String            // Référence BL, Bon d'entrée ou Inventaire
  reason         String?
  performedBy    String
  createdAt      DateTime          @default(now())

  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id])
  product        Product           @relation(fields: [productId], references: [id])
  lot            StockLot?         @relation(fields: [lotId], references: [id])

  @@index([organizationId, productId, createdAt])
}

// ----------------------------------------------------------------------------
// 12, 13 & 14. LIVRAISONS, CONTRÔLE DES QUANTITÉS & RÉCEPTIONS
// ----------------------------------------------------------------------------

model Delivery {
  id                String                  @id @default(cuid())
  organizationId    String
  reference         String                  // Ex: BL-2026-000124
  contractId        String
  orderId           String?
  destinationId     String
  plannedDate       DateTime
  actualDate        DateTime?
  status            DeliveryStatus          @default(DRAFT)
  driverName        String?
  vehiclePlate      String?
  responsibleUser   String
  overrideReason    String?                 // Renseigné si dépassement autorisé par avenant
  notes             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract          Contract                @relation(fields: [contractId], references: [id])
  order             CustomerOrder?          @relation(fields: [orderId], references: [id])
  destination       CustomerAddress         @relation(fields: [destinationId], references: [id])
  lines             DeliveryLine[]
  statusHistory     DeliveryStatusHistory[]
  issues            DeliveryIssue[]
  invoices          Invoice[]
  expenses          Expense[]

  @@unique([organizationId, reference])
  @@index([organizationId, status, plannedDate])
}

model DeliveryLine {
  id                 String       @id @default(cuid())
  deliveryId         String
  contractLineId     String
  productId          String
  lotNumber          String?
  unit               UnitCode
  quantityPlanned    Decimal      @db.Decimal(18, 3)
  quantityDelivered  Decimal      @db.Decimal(18, 3)
  quantityAccepted   Decimal      @db.Decimal(18, 3) @default(0) // Mis à jour uniquement à la réception
  quantityRejected   Decimal      @db.Decimal(18, 3) @default(0)
  unitPrice          Decimal      @db.Decimal(18, 2)
  rejectionReason    String?
  observation        String?

  delivery           Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  contractLine       ContractLine @relation(fields: [contractLineId], references: [id])
  product            Product      @relation(fields: [productId], references: [id])

  @@index([deliveryId])
}

model DeliveryStatusHistory {
  id         String         @id @default(cuid())
  deliveryId String
  status     DeliveryStatus
  changedBy  String
  comment    String?
  changedAt  DateTime       @default(now())

  delivery   Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model DeliveryIssue {
  id          String   @id @default(cuid())
  deliveryId  String
  title       String
  severity    String   // LOW, MEDIUM, HIGH
  description String
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// 15, 16 & 18. TEMPLATES DE BORDEREAUX VERSIONNÉS & GESTION DOCUMENTAIRE
// ----------------------------------------------------------------------------

model DocumentTemplate {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  type           DocumentType
  version        String       // Ex: v2.1-2026
  status         String       // ACTIVE, DRAFT, ARCHIVED
  headerConfig   String       // Configuration JSON des champs d'en-tête et signatures
  effectiveFrom  DateTime
  effectiveTo    DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Document {
  id             String         @id @default(cuid())
  organizationId String
  entityType     String         // CONTRACT, DELIVERY, INVOICE, CUSTOMER, SUPPLIER
  entityId       String
  documentType   DocumentType
  title          String
  fileName       String
  mimeType       String
  storageKey     String
  version        Int            @default(1)
  status         DocumentStatus @default(DRAFT)
  templateUsed   String?
  checksum       String?        // Empreinte SHA-256 pour garantir l'intégrité du document FINAL
  uploadedBy     String
  createdAt      DateTime       @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId])
}

// ----------------------------------------------------------------------------
// 19, 20, 21 & 22. FACTURATION, ABSTRACTION FISCALE, PAIEMENTS & DÉPENSES
// ----------------------------------------------------------------------------

model Invoice {
  id                      String                 @id @default(cuid())
  organizationId          String
  reference               String                 // Ex: FAC-2026-000089
  customerId              String
  contractId              String
  deliveryId              String?
  issueDate               DateTime
  dueDate                 DateTime
  status                  InvoiceStatus          @default(DRAFT)
  subtotal                Decimal                @db.Decimal(18, 2)
  taxAmount               Decimal                @db.Decimal(18, 2)
  totalAmount             Decimal                @db.Decimal(18, 2)
  paidAmount              Decimal                @db.Decimal(18, 2) @default(0)
  remainingAmount         Decimal                @db.Decimal(18, 2)
  taxCertificationStatus  TaxCertificationStatus @default(NOT_SUBMITTED)
  taxCertificationRef     String?                // Référence retournée par le connecteur fiscal si activé
  notes                   String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  organization            Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer                Customer               @relation(fields: [customerId], references: [id])
  contract                Contract               @relation(fields: [contractId], references: [id])
  delivery                Delivery?              @relation(fields: [deliveryId], references: [id])
  allocations             PaymentAllocation[]

  @@unique([organizationId, reference])
  @@index([organizationId, status, dueDate])
}

model Payment {
  id             String              @id @default(cuid())
  organizationId String
  reference      String              // Ex: REG-2026-000045
  customerId     String
  paymentDate    DateTime
  amount         Decimal             @db.Decimal(18, 2)
  method         String              // VIREMENT_TRESOR, VIREMENT_BANCAIRE, CHEQUE, TRAITE
  bankReference  String
  recordedBy     String
  createdAt      DateTime            @default(now())

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  allocations    PaymentAllocation[]

  @@index([organizationId, paymentDate])
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal  @db.Decimal(18, 2)

  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Expense {
  id             String              @id @default(cuid())
  organizationId String
  reference      String
  category       ExpenseCategoryType
  label          String
  amount         Decimal             @db.Decimal(18, 2)
  expenseDate    DateTime
  contractId     String?
  deliveryId     String?
  supplierId     String?
  productId      String?
  status         String              @default("PAID") // PENDING, PAID
  recordedBy     String

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract       Contract?           @relation(fields: [contractId], references: [id])
  delivery       Delivery?           @relation(fields: [deliveryId], references: [id])
  supplier       Supplier?           @relation(fields: [supplierId], references: [id])

  @@index([organizationId, category])
}

// ----------------------------------------------------------------------------
// 28 & 37. SÉQUENCES DE NUMÉROTATION & JOURNAL D'AUDIT IMMUABLE
// ----------------------------------------------------------------------------

model NumberSequence {
  id             String       @id @default(cuid())
  organizationId String
  prefix         String       // BL, FAC, CMD, REG, ACH
  year           Int
  currentValue   Int          @default(0)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, prefix, year])
}

model AuditLog {
  id             String          @id @default(cuid())
  organizationId String
  userId         String
  userName       String
  userRole       RoleName
  action         AuditActionType
  entity         String
  entityId       String
  summary        String
  oldValue       String?         // JSON snapshot
  newValue       String?         // JSON snapshot
  ipAddress      String          @default("10.0.14.22")
  createdAt      DateTime        @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, entity, entityId])
}
